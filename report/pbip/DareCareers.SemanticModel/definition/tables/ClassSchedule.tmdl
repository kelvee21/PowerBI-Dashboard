		dataType: string
		isHidden
		lineageTag: b98164be-e6c6-5638-83a8-94c774e6f0de
		summarizeBy: none
		sourceColumn: CohortTrackKey

		annotation SummarizationSetBy = User

	column Cohort
		dataType: string
		isHidden
		lineageTag: c9dd3724-dbf3-5240-8ab9-68818a19b376
		summarizeBy: none
